<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>QtsBilling.Migration</RootNamespace>
        <AssemblyName>QtsBilling.Migration</AssemblyName>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- No MongoDB dependency: the historical migration reads an exported, hash-verified snapshot
         (spec §6.1); nothing in this repository talks to a MongoDB instance. -->

    <ItemGroup>
        <ProjectReference Include="..\QtsBilling.Persistence.Postgres\QtsBilling.Persistence.Postgres.csproj" />
    </ItemGroup>

</Project>
