<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Browser journeys are an explicit opt-in build (specification tasks 02/11/45). A default build
             never compiles them, so a run without the preloaded browser kit cannot report a browser pass. -->
        <QtsBrowserTests Condition="'$(QtsBrowserTests)' == ''">false</QtsBrowserTests>
    </PropertyGroup>

    <PropertyGroup Condition="'$(QtsBrowserTests)' == 'true'">
        <DefineConstants>$(DefineConstants);QTS_BROWSER_TESTS</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(QtsBrowserTests)' == 'true'">
        <!-- The one approved test-only browser automation dependency. It is never a production reference
             and its browser binaries are preloaded by the offline test kit. -->
        <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Bogus" Version="35.6.5" />
        <PackageReference Include="coverlet.collector" Version="10.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <!-- Override OpenIddict's vulnerable transitive crypto packages in the test host graph. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
        <PackageReference Include="Moq" Version="4.21.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\QtsBilling.Contracts\QtsBilling.Contracts.csproj" />
        <ProjectReference Include="..\QtsModels\QtsModels.csproj" />
        <!-- The integration harness runs the real host against a disposable PostgreSQL database. -->
        <ProjectReference Include="..\QtsWebApp\QtsWebApp\QtsWebApp.csproj" />
        <ProjectReference Include="..\QtsBilling.DataImport\QtsBilling.DataImport.csproj" />
        <ProjectReference Include="..\QtsBilling.Persistence.Sqlite\QtsBilling.Persistence.Sqlite.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Task 02: compile the smoke's exact positive policy into the test assembly. A project
             reference would collide with the web host's top-level Program type. -->
        <Compile Include="..\QtsBilling.Ui.Smoke\SharedUiDependencyPolicy.cs"
                 Link="Architecture\SharedUiDependencyPolicy.cs" />
    </ItemGroup>

</Project>
