<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>QtsBilling.Contracts</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The provider-neutral value objects: one shared commercial calculation for the server,
             the browser and the Windows device (specification D03). -->
        <ProjectReference Include="..\QtsModels\QtsModels.csproj" />
        <!-- The signed offline grant (task 23) is verified by the same code on the server and the device. -->
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    </ItemGroup>

</Project>
