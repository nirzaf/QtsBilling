<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser talks to the server API only; no data-access or source-era assemblies may reach the bundle (QB-15/F-19). -->
    <ProjectReference Include="..\..\QtsBilling.Contracts\QtsBilling.Contracts.csproj" />
    <!-- Shared, host-agnostic MudBlazor components (QB-16): interfaces come from Contracts, nothing from the host. -->
    <ProjectReference Include="..\..\QtsBilling.Ui\QtsBilling.Ui.csproj" />
  </ItemGroup>

</Project>
