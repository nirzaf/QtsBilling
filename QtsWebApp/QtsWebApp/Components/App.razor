<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="QtsWebApp.styles.css" />
    <link rel="stylesheet" href="_content/QtsBilling.Ui/QtsBilling.Ui.bundle.scp.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <!-- Host-owned MudBlazor assets: the shared components render markup only (QB-16); each host loads
         these once in its own shell, including the future MAUI BlazorWebView. No font, icon, script or
         stylesheet is fetched from a public network: the self-hosted profile must render on a machine with
         no internet access, and the system font stack in app.css covers typography (specification task 10). -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>
    <Routes @rendermode="InteractiveAuto" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <!-- Host-owned, local-only print facility (specification task 24): a committed document snapshot is handed to
         the browser's own print dialogue. It fetches nothing and navigates nowhere, so a bearer-protected route
         never needs a token in a URL. -->
    <script src="document-output.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
