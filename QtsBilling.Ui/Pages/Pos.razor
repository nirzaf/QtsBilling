@page "/pos"
@using QtsBilling.Contracts.Pos
@using QtsBilling.Contracts.Sales

<PageTitle>Point of sale - QTS Billing</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
    <MudText Typo="Typo.h3">Point of sale</MudText>
    @if (PosService is not null && PosService.IsOfflineCaptureSupported)
    {
        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">OFFLINE CASH CAPTURE</MudChip>
    }
    else if (PosService is null && OnlineCheckout is not null)
    {
        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">ONLINE CASH SALE</MudChip>
    }
</MudStack>

@if (PosService is null && OnlineCheckout is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
        This host does not provide a point-of-sale checkout.
    </MudAlert>
}
else if (PosService is null)
{
    <MudText Typo="Typo.body2" Class="mt-2">Sales post directly to the server and require an open cash drawer.</MudText>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
    }

    @if (_postedReceipt is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4" Dense="true" ShowCloseIcon="true" CloseIconClicked="ClearPostedReceipt">
            Sale @_postedReceipt.SaleNumber posted. Total: @_postedReceipt.TotalAmount.ToString("0.00") @_postedReceipt.Currency.
            <MudButton Variant="Variant.Text" Color="Color.Success" StartIcon="@Icons.Material.Filled.Print"
                       OnClick="OpenPostedReceiptAsync" Class="ml-2">
                Print 80 mm receipt
            </MudButton>
        </MudAlert>
    }

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="5">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Sale context</MudText>
                    <MudSelect T="Guid?" Label="Location" Value="_onlineLocationId" ValueChanged="OnOnlineLocationChanged"
                               Disabled="@(_busy || _onlineAttempt is not null || _loadingContext)" Class="mt-2">
                        @foreach (var location in _locations)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)location.Id)">@location.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="Guid?" Label="Cash register" Value="_onlineRegisterId" ValueChanged="OnOnlineRegisterChanged"
                               Disabled="@(_busy || _onlineAttempt is not null || _loadingContext || _onlineLocationId is null)" Class="mt-2">
                        @foreach (var register in RegistersForSelectedLocation)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)register.Id)">
                                @register.Name@(register.CurrentSession is { Status: CashRegisterSessionState.Open } session ? $" — open ({session.Currency})" : " — closed")
                            </MudSelectItem>
                        }
                    </MudSelect>
                    @if (_onlineLocationId is not null && RegistersForSelectedLocation.All(register => register.CurrentSession is not { Status: CashRegisterSessionState.Open }))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                            No open cash drawer is available at this location. Select a closed register to open one if you have register-management permission.
                        </MudAlert>
                    }
                    @if (SelectedOnlineRegister is { } selectedRegister && selectedRegister.CurrentSession is not { Status: CashRegisterSessionState.Open })
                    {
                        <MudNumericField T="decimal" @bind-Value="_openingFloat" Label="Opening cash float" Min="0m" Step="0.5m"
                                         Class="mt-2" Disabled="@(_busy || _onlineAttempt is not null)" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LockOpen"
                                   Disabled="@(_busy || _onlineAttempt is not null || _openingFloat < 0m)"
                                   OnClick="@(() => OpenDrawerAsync(selectedRegister.Id))" Class="mt-2">
                            @(_busy ? "Opening drawer..." : "Open cash drawer")
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mt-1">Requires register-management permission. Opening float is recorded in the drawer audit.</MudText>
                    }
                    else if (SelectedOnlineRegister?.CurrentSession is { Status: CashRegisterSessionState.Open } openSession)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                            Drawer open in @openSession.Currency. Expected cash: @openSession.ExpectedCash?.ToString("0.00").
                        </MudAlert>
                    }
                    <MudTextField @bind-Value="_search"
                                  @bind-Value:after="SearchOnlineCatalogAsync"
                                  Label="Search catalog"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="400"
                                  Disabled="@(_onlineLocationId is null || _onlineAttempt is not null)"
                                  Class="mt-3" />
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                               Disabled="@(_catalogLoading || _onlineLocationId is null || _onlineAttempt is not null)"
                               OnClick="RefreshOnlineCatalogAsync" Class="mt-2">
                        @(_catalogLoading ? "Loading catalog..." : "Refresh catalog")
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="mt-1">Choose a product to add it to the sale. The server checks its current price and stock.</MudText>
                </MudCardContent>
            </MudCard>

            <MudStack Spacing="1" Class="mt-2">
                @foreach (var item in Filtered)
                {
                    <MudButton Variant="Variant.Outlined" FullWidth="true" Class="justify-space-between"
                               Disabled="@(_busy || _onlineAttempt is not null)" OnClick="@(() => AddLine(item))">
                        <span>@item.Name <small>(@item.Sku)</small></span>
                        <span>@item.UnitPrice.ToString("0.00")</span>
                    </MudButton>
                }
                @if (_catalogLoading && _catalog.Count == 0)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (_catalog.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No matching products. Search by product name or SKU.</MudAlert>
                }
                @if (_catalogCursor is not null)
                {
                    <MudButton Variant="Variant.Text" Disabled="@_catalogLoading" OnClick="LoadMoreOnlineCatalogAsync">Load more products</MudButton>
                }
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Current sale</MudText>
                    <MudTable Items="@_lines" Dense="true" Hover="true" Class="mt-2">
                        <HeaderContent>
                            <MudTh>Item</MudTh><MudTh>Qty</MudTh><MudTh>Unit price</MudTh><MudTh>Total</MudTh><MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Item">@context.Name</MudTd>
                            <MudTd DataLabel="Qty">@context.Quantity.ToString("0.##")</MudTd>
                            <MudTd DataLabel="Unit price">@context.UnitPrice.ToString("0.00")</MudTd>
                            <MudTd DataLabel="Total">@LineTotal(context).ToString("0.00")</MudTd>
                            <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="@($"Remove {context.Name}")"
                                                   Color="Color.Error" Size="Size.Small" Disabled="@(_busy || _onlineAttempt is not null)"
                                                   OnClick="@(() => RemoveLine(context))" /></MudTd>
                        </RowTemplate>
                        <NoRecordsContent><MudText Typo="Typo.body2" Class="pa-4">Choose products to start a sale.</MudText></NoRecordsContent>
                    </MudTable>
                    <MudNumericField T="decimal?" @bind-Value="_cashReceived" Label="Cash received" Min="0m" Step="0.5m"
                                     Class="mt-2" Disabled="@(_busy || _onlineAttempt is not null)" />
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                        <MudText>Total</MudText><MudText>@Total.ToString("0.00")</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText>Change</MudText><MudText>@Math.Max(0m, Change).ToString("0.00")</MudText>
                    </MudStack>
                    @if (_onlineAttempt is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                            The post result is uncertain. Retry sends the same sale with its original idempotency key.
                        </MudAlert>
                    }
                    @if (_onlineAttemptRejected)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true" Class="mt-2"
                                   OnClick="StartFreshAfterRejectionAsync">
                            Clear rejected sale and refresh
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PointOfSale"
                               FullWidth="true" Class="mt-3"
                               Disabled="@(_busy || _lines.Count == 0 || _onlineLocationId is null || !CanPostOnline || (_cashReceived ?? Total) < Total)"
                               OnClick="CaptureAsync">
                        @(_busy ? "Posting..." : _onlineAttempt is null ? "Post cash sale" : "Retry sale post")
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
else if (!PosService.IsOfflineCaptureSupported)
{
    <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
        Offline cash capture is a desktop-client feature. The browser posts sales to the server directly.
    </MudAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
    }

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="5">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Catalog (cached)</MudText>
                    <MudTextField @bind-Value="_search"
                                  @bind-Value:after="FilterAsync"
                                  Label="Search catalog"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="400"
                                  Class="mt-2" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               Disabled="@_busy"
                               OnClick="RefreshCatalogAsync"
                               Class="mt-2">
                        Refresh catalog (online)
                    </MudButton>
                </MudCardContent>
            </MudCard>

            <MudList T="string" Class="mt-2">
                @foreach (var item in Filtered)
                {
                    <MudListItem T="string" OnClick="@(() => AddLine(item))" Class="cursor-pointer">
                        <div class="d-flex justify-space-between align-center">
                            <div>
                                <MudText Typo="Typo.body1">@item.Name</MudText>
                                <MudText Typo="Typo.caption">@item.Sku</MudText>
                            </div>
                            <div class="text-right">
                                <MudText Typo="Typo.body1">@item.UnitPrice.ToString("0.00")</MudText>
                                @if (item.OnHand is { } onHand)
                                {
                                    <MudText Typo="Typo.caption">on hand @onHand.ToString("0.##")</MudText>
                                }
                            </div>
                        </div>
                    </MudListItem>
                }
                @if (Filtered.Count == 0)
                {
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2" Class="pa-2">
                            No cached products. Download the catalog while the device is online.
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">Current sale</MudText>

                    <MudTable Items="@_lines" Dense="true" Hover="true" Class="mt-2">
                        <HeaderContent>
                            <MudTh>Item</MudTh>
                            <MudTh>Qty</MudTh>
                            <MudTh>Unit price</MudTh>
                            <MudTh>Total</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Item">@context.Name</MudTd>
                            <MudTd DataLabel="Qty">@context.Quantity.ToString("0.##")</MudTd>
                            <MudTd DataLabel="Unit price">@context.UnitPrice.ToString("0.00")</MudTd>
                            <MudTd DataLabel="Total">@LineTotal(context).ToString("0.00")</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               Disabled="@_busy"
                                               OnClick="@(() => RemoveLine(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Class="pa-4">No items yet. Pick them from the cached catalog.</MudText>
                        </NoRecordsContent>
                    </MudTable>

                    <MudNumericField T="decimal?"
                                     @bind-Value="_cashReceived"
                                     Label="Cash received"
                                     Min="0m"
                                     Step="0.5m"
                                     Class="mt-2"
                                     Disabled="@_busy" />

                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                        <MudText Typo="Typo.body1">Total</MudText>
                        <MudText Typo="Typo.body1">@Total.ToString("0.00")</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body1">Change</MudText>
                        <MudText Typo="Typo.body1">@Change.ToString("0.00")</MudText>
                    </MudStack>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PointOfSale"
                               FullWidth="true"
                               Class="mt-3"
                               Disabled="@(_busy || _lines.Count == 0)"
                               OnClick="CaptureAsync">
                        @(_busy ? "Capturing..." : "Capture cash sale (offline)")
                    </MudButton>
                </MudCardContent>
            </MudCard>

            @if (_receipt is not null)
            {
                <QtsBilling.Ui.Components.ProvisionalReceipt Sale="@_receipt" Names="@_names" />
            }

            <MudCard Class="mt-2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Device sync</MudText>
                    @if (Sync is not null)
                    {
                        <MudStack Row="true" Spacing="2" Class="mt-2" AlignItems="AlignItems.Center">
                            <MudChip T="string" Size="Size.Small" Color="@(_status?.Online == true ? Color.Success : Color.Warning)">
                                @(_status?.Online == true ? "Online" : "Offline")
                            </MudChip>
                            <MudText Typo="Typo.body2">@_status?.PendingOperations waiting to be sent</MudText>
                            <MudText Typo="Typo.body2">@_status?.Conflicts conflict(s)</MudText>
                            <MudText Typo="Typo.body2">revision @_status?.LastRevision</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="mt-1">
                            Last successful pull: @(_status?.LastSuccessUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "never")
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   Disabled="@_syncing"
                                   OnClick="SyncNowAsync"
                                   Class="mt-2">
                            @(_syncing ? "Synchronizing..." : "Sync now")
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mt-1">
                            This host has no device queue, so it does not synchronize.
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>

            @if (_conflicts.Count > 0)
            {
                <MudCard Class="mt-2">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">Conflicts</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@_conflicts.Count</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="mt-1">
                            The server changed a record that a pending local sale uses. Nothing was overwritten:
                            choose which value wins.
                        </MudText>
                        <MudList T="string" Class="mt-1">
                            @foreach (var conflict in _conflicts)
                            {
                                <MudListItem T="string">
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <MudText Typo="Typo.body2">@conflict.EntityType @conflict.EntityId</MudText>
                                            <MudText Typo="Typo.caption">@conflict.Reason</MudText>
                                        </div>
                                        <div class="d-flex align-center">
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Text"
                                                       Disabled="@_busy"
                                                       OnClick="@(() => ResolveConflictAsync(conflict, SyncConflictResolution.UseServer))">
                                                Use server
                                            </MudButton>
                                            <MudButton Size="Size.Small"
                                                       Variant="Variant.Text"
                                                       Disabled="@_busy"
                                                       OnClick="@(() => ResolveConflictAsync(conflict, SyncConflictResolution.KeepLocal))">
                                                Keep local
                                            </MudButton>
                                        </div>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudCardContent>
                </MudCard>
            }

            <MudCard Class="mt-2">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Pending queue</MudText>
                    <MudText Typo="Typo.caption">
                        Captured on this device and waiting for the server. A provisional reference is not a
                        sale number.
                    </MudText>
                    <MudList T="string" Class="mt-2">
                        @foreach (var pending in _pending)
                        {
                            <MudListItem T="string">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.body2"><code>@pending.ProvisionalReference</code></MudText>
                                        <MudText Typo="Typo.caption">
                                            @pending.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC Â·
                                            @pending.Amount.ToString("0.00")
                                        </MudText>
                                        @if (!string.IsNullOrWhiteSpace(pending.LastError))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Error">@pending.LastError</MudText>
                                        }
                                    </div>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Color="@(pending.State == "Rejected" ? Color.Error : pending.State == "Posted" ? Color.Success : Color.Warning)">
                                        @(pending.State == "Rejected" ? "Rejected" : pending.State == "Posted" ? "Posted" : "Pending sync")
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                        @if (_pending.Count == 0)
                        {
                            <MudListItem T="string">
                                <MudText Typo="Typo.body2" Class="pa-2">Nothing is waiting to be sent.</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

