@page "/invoices/new"
@page "/invoices/{InvoiceId:guid}"
@using QtsBilling.Contracts.Clients
@using QtsBilling.Contracts.Customers
@using QtsBilling.Contracts.Inventory
@using QtsBilling.Contracts.Pos
@using QtsModels.ValueObjects

<PageTitle>@(_isNew ? "New invoice" : "Invoice") - QTS Billing</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h3">@(_isNew ? "New invoice" : _detail?.Invoice.InvoiceNumber ?? "Invoice")</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Draft details and controlled issue actions.</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Href="invoices">Back to invoices</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!_canRead)
{
    <MudAlert Severity="Severity.Warning">Your current role cannot view invoices.</MudAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3" role="alert">@_error</MudAlert>
    }

    @if (_detail is not null && !_isEditable)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">@ReadOnlyMessage</MudAlert>
        <MudPaper Class="pa-4" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6"><MudText><b>Customer:</b> @(_detail.Invoice.CustomerName ?? InvoiceRules.NoCustomerRecorded)</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText><b>Dates:</b> @InvoiceRules.DateText(_detail.Invoice.IssueDate) · due @(_detail.Invoice.DueDate is { } due ? InvoiceRules.DateText(due) : "—")</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText><b>Recognition:</b> @InvoiceRules.RecognitionText(_detail.Invoice.RecognitionMode)</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText><b>Settlement scale:</b> @(InvoiceRules.Scale(_detail) is { } scale ? $"{scale} decimals, in the business's own calendar" : "not configured for this business")</MudText></MudItem>
                <MudItem xs="12">
                    <MudTable Items="_detail.Lines" Dense="true" Hover="true" aria-label="Invoice lines">
                        <HeaderContent><MudTh>Item</MudTh><MudTh>Qty</MudTh><MudTh>Unit price</MudTh><MudTh>Tax</MudTh><MudTh>Total</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Item">@context.ProductName</MudTd>
                            <MudTd DataLabel="Qty">@InvoiceRules.Money(context.Quantity, null)</MudTd>
                            <MudTd DataLabel="Unit price">@InvoiceRules.Money(context.UnitPrice, InvoiceRules.Scale(_detail))</MudTd>
                            <MudTd DataLabel="Tax">@InvoiceRules.Money(context.TaxAmount, InvoiceRules.Scale(_detail))</MudTd>
                            <MudTd DataLabel="Total">@InvoiceRules.Money(context.LineTotal, InvoiceRules.Scale(_detail))</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
                <MudItem xs="12" sm="6"><MudText><b>Total:</b> @InvoiceRules.MoneyText(_detail.Invoice.TotalAmount, _detail.Invoice.Currency, InvoiceRules.Scale(_detail))</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText><b>Balance due:</b> @InvoiceRules.MoneyText(_detail.Invoice.BalanceDue, _detail.Invoice.Currency, InvoiceRules.Scale(_detail))</MudText></MudItem>
                @if (_isIssuable)
                {
                    <MudItem xs="12"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="IssueAsync" Disabled="@_busy">@(_busy ? "Issuing…" : "Issue invoice")</MudButton></MudItem>
                }
            </MudGrid>
        </MudPaper>

        @* Settlement, credits, tender clearance and printing of an issued document are one workbench (task 24).
           Printing is not a link here: a link to an API route can only be authenticated by a cookie or by a token
           in the URL, and a terminal has neither. *@
        <InvoiceActions Detail="_detail" Access="_access" Reload="LoadAsync" />
    }
    else if (_isEditable)
    {
        <MudPaper Class="pa-4" Outlined="true">
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="CustomerDto" Label="Customer" Value="_selectedCustomer" ValueChanged="OnCustomerChanged"
                                         SearchFunc="SearchCustomersAsync" ToStringFunc="@(customer => customer?.Name ?? string.Empty)"
                                         Clearable="true" ResetValueOnEmptyText="true" DebounceInterval="300" Variant="Variant.Outlined"
                                         HelperText="A customer is required: the amount owed is tracked against them" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?" Label="Location" @bind-Value="_form.LocationId" Variant="Variant.Outlined" Clearable="true">
                            @foreach (var location in _locations) { <MudSelectItem T="Guid?" Value="@((Guid?)location.Id)">@location.Name</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudDatePicker Label="Issue date" @bind-Date="_issueDate" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="6"><MudDatePicker Label="Due date" @bind-Date="_dueDate" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12"><MudTextField Label="Note" @bind-Value="_form.Note" Variant="Variant.Outlined" Lines="2" MaxLength="1000" /></MudItem>
                    <MudItem xs="12"><MudText Typo="Typo.h6">Lines</MudText></MudItem>
                    @for (var i = 0; i < _form.Lines.Count; i++)
                    {
                        var index = i;
                        <MudItem xs="12" md="4"><MudTextField Label="Description" @bind-Value="_form.Lines[index].ProductName" Variant="Variant.Outlined" Required="true" /></MudItem>
                        <MudItem xs="6" md="2"><MudNumericField T="decimal" Label="Quantity" @bind-Value="_form.Lines[index].Quantity" Min="0.001m" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="6" md="2"><MudNumericField T="decimal" Label="Unit price" @bind-Value="_form.Lines[index].UnitPrice" Min="0m" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="6" md="2"><MudNumericField T="decimal" Label="Discount" @bind-Value="_form.Lines[index].DiscountAmount" Min="0m" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="6" md="1"><MudNumericField T="decimal" Label="Tax %" @bind-Value="_form.Lines[index].TaxRate" Min="0m" Max="100m" Variant="Variant.Outlined" /></MudItem>
                        <MudItem xs="12" md="1" Class="d-flex align-center"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Remove invoice line" OnClick="@(() => RemoveLine(index))" Disabled="@(_form.Lines.Count <= 1)" /></MudItem>
                    }
                    <MudItem xs="12"><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine" Disabled="@_busy">Add line</MudButton></MudItem>
                    <MudItem xs="12"><MudTextField Label="Estimated total (the server calculates the final total on save)" Value="@EstimateText" ReadOnly="true" Variant="Variant.Outlined" HelperText="Estimate only: tax rates are entered as percentages and converted once." /></MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy">@(_busy ? "Saving…" : "Save draft")</MudButton>
                            @if (_isIssuable)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="IssueAsync" Disabled="@_busy">Issue invoice</MudButton>
                            }
                            @if (!_isNew && _detail is not null && _canManage)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DeleteAsync" Disabled="@_busy">Delete draft</MudButton>
                            }
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudPaper>
    }
}

@code {
    [Parameter] public Guid? InvoiceId { get; set; }
    [Inject] private IInvoiceApiClient InvoiceApi { get; set; } = default!;
    [Inject] private IAccountApiClient Accounts { get; set; } = default!;
    [Inject] private ICustomerApiClient CustomersApi { get; set; } = default!;
    [Inject] private IInventoryApiClient InventoryApi { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private readonly InvoiceForm _form = new();
    private IReadOnlyList<BusinessLocationDto> _locations = [];
    private CustomerDto? _selectedCustomer;
    private InvoiceDetailDto? _detail;
    private DateTime? _issueDate;
    private DateTime? _dueDate;
    private bool _loading = true;
    private bool _busy;
    private bool _canRead;
    private bool _canManage;
    private bool _canIssue;
    private int _loadVersion;
    private bool _isNew => InvoiceId is null;
    private string? _error;
    private InvoiceAccess _access = new(false, false, false, false);

    // Only draft Service and DirectGoods invoices are edited here; source-linked and unknown-mode drafts are read-only.
    private bool _isEditable => _canManage && (_isNew || _detail is { Invoice.Status: InvoiceState.Draft } && IsEditableMode(_detail.Invoice.RecognitionMode));
    private bool _isIssuable => _canIssue && _detail is { Invoice.Status: InvoiceState.Draft } && IsEditableMode(_detail.Invoice.RecognitionMode);

    private string ReadOnlyMessage => _detail is null ? string.Empty
        : _detail.Invoice.Status != InvoiceState.Draft ? $"This invoice is {StatusLabel(_detail.Invoice.Status)}. Draft fields are locked after issue."
        : !_canManage ? "You can view this draft, but your role cannot edit it."
        : _detail.Invoice.RecognitionMode == InvoiceRecognitionMode.HistoricalUnknown
            ? "This draft predates recognition modes, so it cannot be issued. Create a new draft instead."
            : $"This draft is maintained by its {InvoiceRules.RecognitionText(_detail.Invoice.RecognitionMode)} workflow.";

    private string EstimateText => ComputeEstimate() is { } total ? InvoiceRules.Money(total, _detail is null ? null : InvoiceRules.Scale(_detail)) : "—";

    protected override async Task OnParametersSetAsync()
    {
        // Each load gets a version; an older response that completes late is discarded instead of replacing the new route.
        var version = ++_loadVersion;
        ResetState();
        _loading = true;
        await LoadAsync(version);
    }

    /// <summary>
    /// Reads the session, the branches and the document. The settlement workbench calls it back after every
    /// posted action and after a version conflict, so a screen never keeps figures the server has already moved.
    /// </summary>
    private async Task LoadAsync()
    {
        await LoadAsync(_loadVersion);
    }

    private async Task LoadAsync(int version)
    {
        try
        {
            var session = await Accounts.GetSessionAsync();
            if (version != _loadVersion) return;

            _canRead = session?.Permissions.Contains(Permissions.InvoicesIssue, StringComparer.Ordinal) == true || session?.Permissions.Contains(Permissions.InvoicesManage, StringComparer.Ordinal) == true;
            _canManage = session?.Permissions.Contains(Permissions.InvoicesManage, StringComparer.Ordinal) == true;
            _canIssue = session?.Permissions.Contains(Permissions.InvoicesIssue, StringComparer.Ordinal) == true;

            // What the workbench may offer is decided by the authorities this session actually holds - the same
            // ones the routes check - so a button is never offered on a guess and a refusal always names what is missing.
            _access = new InvoiceAccess(
                CanSettle: _canIssue,
                CanManage: _canManage,
                CanPost: session?.Permissions.Contains(Permissions.AccountingPost, StringComparer.Ordinal) == true,
                CanReadRegisters: session?.Permissions.Contains(Permissions.SalesPost, StringComparer.Ordinal) == true);
            if (!_canRead) return;

            if (_canManage)
            {
                _locations = await InventoryApi.GetLocationsAsync();
                if (version != _loadVersion) return;
            }

            if (InvoiceId is { } id)
            {
                var detail = await InvoiceApi.GetAsync(id);
                if (version != _loadVersion) return;

                _detail = detail;
                var invoice = detail.Invoice;
                _form.CustomerId = invoice.CustomerId;
                _form.LocationId = detail.LocationId;
                _form.Note = invoice.Note;
                _issueDate = invoice.IssueDate.ToDateTime(TimeOnly.MinValue);
                _dueDate = invoice.DueDate?.ToDateTime(TimeOnly.MinValue);
                _form.Lines.Clear();
                _form.Lines.AddRange(detail.Lines.Select(line => new InvoiceLineForm
                {
                    VariantId = line.VariantId,
                    ProductName = line.ProductName,
                    Quantity = line.Quantity,
                    UnitPrice = line.UnitPrice,
                    DiscountAmount = line.DiscountAmount,
                    // The wire carries a fraction (0.15); the form edits percent units (15).
                    TaxRate = line.TaxRate * 100m,
                }));

                if (_canManage && invoice.CustomerId is { } customerId && !string.IsNullOrWhiteSpace(invoice.CustomerName))
                {
                    _selectedCustomer = await FindCustomerAsync(customerId, invoice.CustomerName);
                    if (version != _loadVersion) return;
                }
            }
            else if (_locations.Count == 1)
            {
                _form.LocationId = _locations[0].Id;
            }

            if (_isNew)
            {
                OfferBusinessDate();
            }
        }
        catch (ApiException ex)
        {
            if (version == _loadVersion) _error = ex.Message;
        }
        finally
        {
            if (version == _loadVersion) _loading = false;
        }
    }

    private void ResetState()
    {
        _detail = null;
        _error = null;
        _selectedCustomer = null;
        _locations = [];
        _form.CustomerId = null;
        _form.LocationId = null;
        _form.Note = null;
        _form.Lines.Clear();
        _form.Lines.Add(new InvoiceLineForm());
        _issueDate = null;
        _dueDate = null;
        _canRead = false;
        _canManage = false;
        _canIssue = false;
    }

    /// <summary>
    /// A brand-new draft is dated on the trading day of the branch it will be raised at, not on the date the
    /// machine it happens to be typed on believes it is (finding F21). A branch carries its own time zone and the
    /// screen already reads the branch list, so the offered date is the business's; the operator may still change
    /// it, and an existing document always keeps the date it was raised with.
    /// </summary>
    private void OfferBusinessDate()
    {
        var zone = (_form.LocationId is { } locationId
                ? _locations.FirstOrDefault(candidate => candidate.Id == locationId)
                : _locations.Count == 1 ? _locations[0] : null)?.TimeZone;

        _issueDate = InvoiceRules.BusinessClock(zone).ToDateTime(TimeOnly.MinValue);
    }

    private async Task<IEnumerable<CustomerDto>> SearchCustomersAsync(string text, CancellationToken cancellationToken)
    {
        try
        {
            var page = await CustomersApi.GetCustomersAsync(
                search: string.IsNullOrWhiteSpace(text) ? null : text.Trim(),
                pageSize: 25,
                cancellationToken: cancellationToken);
            return page.Items;
        }
        catch (OperationCanceledException)
        {
            return [];
        }
        catch (ApiException)
        {
            return [];
        }
    }

    private async Task<CustomerDto?> FindCustomerAsync(Guid customerId, string customerName)
    {
        try
        {
            var page = await CustomersApi.GetCustomersAsync(search: customerName, pageSize: 25);
            return page.Items.FirstOrDefault(customer => customer.Id == customerId);
        }
        catch (ApiException)
        {
            return null;
        }
    }

    private void OnCustomerChanged(CustomerDto? customer)
    {
        _selectedCustomer = customer;
        _form.CustomerId = customer?.Id;
    }

    private decimal? ComputeEstimate()
    {
        try
        {
            var lines = _form.Lines
                .Select(line => new CommercialLineInput
                {
                    Quantity = line.Quantity,
                    UnitPrice = line.UnitPrice,
                    DiscountAmount = line.DiscountAmount,
                    TaxRate = line.TaxRate / 100m,
                    TaxMode = CommercialTaxMode.Exclusive,
                })
                .ToArray();
            return CommercialAmountCalculator.ComputeDocument(lines).PayableAmount;
        }
        catch (CommercialAmountException)
        {
            return null;
        }
    }

    private async Task SaveAsync()
    {
        if (!_isEditable || _busy) return;
        if (_form.CustomerId is null)
        { _error = InvoiceRules.NeedsCustomer; return; }
        if (_form.Lines.Count == 0 || _form.Lines.Any(x => string.IsNullOrWhiteSpace(x.ProductName) || x.Quantity <= 0 || x.UnitPrice < 0 || x.DiscountAmount < 0 || x.TaxRate < 0 || x.TaxRate > 100))
        { _error = "Enter a description and valid quantity, price, discount, and tax (0–100%) for every line."; return; }

        _busy = true;
        _error = null;
        try
        {
            // Updates keep the recognition mode the draft already has; only new drafts are created as Service.
            var mode = _isNew ? InvoiceRecognitionMode.Service : _detail!.Invoice.RecognitionMode;
            var date = DateOnly.FromDateTime(_issueDate ?? InvoiceRules.BusinessClock().ToDateTime(TimeOnly.MinValue));
            var request = new SaveInvoiceRequest(
                _form.LocationId,
                _form.CustomerId,
                date,
                _dueDate is null ? null : DateOnly.FromDateTime(_dueDate.Value),
                _form.Note,
                _form.Lines.Select(x => new InvoiceLineRequest(x.VariantId, x.ProductName.Trim(), x.Quantity, x.UnitPrice, x.DiscountAmount, x.TaxRate / 100m)).ToArray(),
                mode,
                ExpectedVersion: _isNew ? null : _detail?.Invoice.Version);

            var saved = _isNew ? await InvoiceApi.CreateAsync(request) : await InvoiceApi.UpdateAsync(InvoiceId!.Value, request);
            Navigation.NavigateTo($"invoices/{saved.Invoice.Id:D}", replace: true);
        }
        catch (ApiException ex)
        {
            // The entered values stay in the form so the operator can reload or review them after a version conflict.
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task IssueAsync()
    {
        if (!_isIssuable || _detail is null || _busy) return;

        _busy = true;
        _error = null;
        try
        {
            _detail = await InvoiceApi.IssueAsync(_detail.Invoice.Id);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (!_canManage || _detail is null || _busy) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete draft",
            "This removes the draft invoice. Issued invoices cannot be deleted; they are voided or credited.",
            yesText: "Delete",
            cancelText: "Keep draft");
        if (confirmed != true) return;

        _busy = true;
        _error = null;
        try
        {
            await InvoiceApi.DeleteAsync(_detail.Invoice.Id);
            Navigation.NavigateTo("invoices");
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void AddLine() => _form.Lines.Add(new InvoiceLineForm());
    private void RemoveLine(int index) { if (_form.Lines.Count > 1) _form.Lines.RemoveAt(index); }
    private static bool IsEditableMode(InvoiceRecognitionMode mode) => mode is InvoiceRecognitionMode.Service or InvoiceRecognitionMode.DirectGoods;
    private static string StatusLabel(InvoiceState status) => status == InvoiceState.PartiallyPaid ? "partially paid" : status.ToString().ToLowerInvariant();

    private sealed class InvoiceForm
    {
        public Guid? CustomerId { get; set; }
        public Guid? LocationId { get; set; }
        public string? Note { get; set; }
        public List<InvoiceLineForm> Lines { get; } = [new()];
    }

    private sealed class InvoiceLineForm
    {
        public Guid? VariantId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1m;
        public decimal UnitPrice { get; set; }
        public decimal DiscountAmount { get; set; }
        /// <summary>Tax as a percentage (15 = 15%); converted once to a fraction at the wire boundary.</summary>
        public decimal TaxRate { get; set; }
    }
}
