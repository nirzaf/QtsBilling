@page "/customers"
@implements IAsyncDisposable
@using QtsBilling.Contracts.Abstractions
@using QtsBilling.Contracts.Customers
@using QtsBilling.Contracts.Identity

<PageTitle>Customers - QTS Billing</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h3">Customers</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            The people and companies this business invoices. Search and paging run on the server, so a long customer
            file stays reachable - nothing here is a first-hundred subset.
        </MudText>
    </div>
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync" Disabled="@(_busy || _list.IsBusy)">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddCustomer"
                   StartIcon="@Icons.Material.Filled.Add" Disabled="@(!_canWrite || _busy)">
            Add Customer
        </MudButton>
    </MudStack>
</MudStack>

@*
    A deactivated customer is not deleted: invoices and sales still name them, and the receivables statement
    arrives with task 25. The screen says so instead of leaving an operator to guess why a name disappeared.
*@
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    Taking a customer out of service keeps every invoice and sale that names them. The record stops appearing in
    pickers for new work, and stays reachable here for as long as its history exists.
</MudAlert>

@if (_problem is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3" role="alert">@_problem</MudAlert>
}

    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="5">
                <MudTextField @bind-Value="_searchText" Label="Search customers"
                              HelperText="Name, email or phone. Runs on the server across the whole file."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Immediate="true" DebounceInterval="350"
                              OnDebounceIntervalElapsed="SearchChanged"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4" md="4">
                <MudSwitch T="bool" @bind-Value="_includeInactive" @bind-Value:after="IncludeInactiveChanged"
                           Label="Include out of service" Color="Color.Primary" Class="pt-2" />
            </MudItem>
            <MudItem xs="12" sm="2" md="3">
                <MudText Typo="Typo.caption" Align="Align.Right" Class="pb-2">@_list.Rows.Count customer(s) on this page</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <ShellStates Kind="_list.State" Body="_list.Message" RetryCallback="ReloadAsync">
        <MudTable Items="@_list.Rows" Loading="@(_list.IsBusy || _busy)" Dense="true" Hover="true" Striped="true" Bordered="true"
              Breakpoint="Breakpoint.Sm" aria-label="Customers">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Address</MudTh>
            <MudTh>State</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                @if (context.IsEditing)
                {
                    <MudTextField @bind-Value="context.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                else
                {
                    @context.Name
                }
                @if (context.ConflictNote is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" role="alert">@context.ConflictNote</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Email">
                @if (context.IsEditing)
                {
                    <MudTextField @bind-Value="context.Email" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                else if (!string.IsNullOrWhiteSpace(context.Email))
                {
                    <MudLink Href="@($"mailto:{context.Email}")">@context.Email</MudLink>
                }
            </MudTd>
            <MudTd DataLabel="Phone">
                @if (context.IsEditing)
                {
                    <MudTextField @bind-Value="context.Phone" Label="Phone" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                else if (!string.IsNullOrWhiteSpace(context.Phone))
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">@context.Phone</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Address">
                @if (context.IsEditing)
                {
                    <MudTextField @bind-Value="context.Address" Label="Address" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="text-truncate">@context.Address</MudText>
                }
            </MudTd>
            <MudTd DataLabel="State">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.Dto.IsActive ? Color.Success : Color.Default)">
                    @(context.Dto.IsActive ? "Active" : "Out of service")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                               OnClick="@((args) => ToggleEdit(args, context))"
                               StartIcon="@Icons.Material.Filled.Edit" Disabled="@(!_canWrite || _busy)">
                        @(context.IsEditing ? "Save" : "Edit")
                    </MudButton>
                    @if (context.Dto.IsActive)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                   OnClick="@((args) => DeleteCustomerConfirmation(args, context))"
                                   StartIcon="@Icons.Material.Filled.Block" Disabled="@(!_canWrite || _busy)">
                            Deactivate
                        </MudButton>
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4">
                @if (string.IsNullOrWhiteSpace(_searchText))
                {
                    @("This business has no customers yet. Add the first one, or include out-of-service records to see history.")
                }
                else
                {
                    @($"Nothing matches \"{_searchText}\" in this business. The search covers the whole customer file, not only this page.")
                }
            </MudText>
        </NoRecordsContent>
    </MudTable>

    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
        <MudButton Variant="Variant.Outlined" OnClick="PreviousAsync" Disabled="@(_list.IsBusy || !_list.CanGoPrevious)">Previous</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="NextAsync" Disabled="@(_list.IsBusy || !_list.CanGoNext)">Next</MudButton>
    </MudStack>
</ShellStates>
