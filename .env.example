# ---------------------------------------------------------------------------
# QtsBilling — environment configuration template
# ---------------------------------------------------------------------------
# Copy these values into your environment. NEVER commit real secrets.
#
#   Windows (PowerShell, current session):
#     $env:QTS_POSTGRES_CONNECTION = "Host=localhost;Port=5432;Database=qtsbilling;Username=...;Password=..."
#   Windows (persistent, user scope):
#     setx QTS_POSTGRES_CONNECTION "Host=...;Database=...;Username=...;Password=..."
#   macOS / Linux:
#     export QTS_POSTGRES_CONNECTION="Host=...;Database=...;Username=...;Password=..."
#
# See the "Configuration" section of the README for full details.
# ---------------------------------------------------------------------------

# PostgreSQL 18 authoritative connection string (REQUIRED to run the web host / apply migrations).
# The value below is a throwaway local-dev default only — never point it at production secrets.
QTS_POSTGRES_CONNECTION=Host=localhost;Port=5432;Database=qtsbilling;Username=qtsbilling;Password=qtsbilling
