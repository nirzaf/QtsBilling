# ---------------------------------------------------------------------------
# QtsBilling — environment configuration template
# ---------------------------------------------------------------------------
# Copy these values into your environment. NEVER commit real secrets.
#
#   Windows (PowerShell, current session):
#     $env:QTS_MONGODB_REMOTE = "mongodb+srv://<user>:<password>@<host>/?retryWrites=true&w=majority"
#   Windows (persistent, user scope):
#     setx QTS_MONGODB_REMOTE "mongodb+srv://<user>:<password>@<host>/?retryWrites=true&w=majority"
#   macOS / Linux:
#     export QTS_MONGODB_REMOTE="mongodb+srv://<user>:<password>@<host>/?retryWrites=true&w=majority"
#
# See the "Configuration" section of the README for full details.
# ---------------------------------------------------------------------------

# Primary / remote MongoDB connection string (REQUIRED).
# For local-only development you may point this at a local MongoDB instance.
QTS_MONGODB_REMOTE=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Optional local MongoDB connection string.
# Defaults to mongodb://localhost:27017/qts-Billing when unset.
QTS_MONGODB_LOCAL=mongodb://localhost:27017/qts-Billing

# Optional AES key and IV (Base64-encoded) used by EncryptionService.
# Generate a pair by running EncryptionService.GenerateKeyAndIV().
QTS_ENCRYPTION_KEY=
QTS_ENCRYPTION_IV=
