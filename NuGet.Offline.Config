<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore configuration for the sealed QtsBilling build kit (specification task 11).

  This file is deliberately NOT named NuGet.config: nothing picks it up by accident and the normal connected
  build keeps working. A build user passes it explicitly with the configfile option, or runs
  "pwsh -File scripts/prepare-build-kit.ps1 -Action Verify", and the restore then has exactly one source: the
  kit's own package directory. Public sources are cleared, fallback package folders are cleared, and the
  package cache is redirected into the kit, so an ambient global cache or a machine-level feed cannot answer a
  request and would not be consulted if it could.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="qts-build-kit" value="build-kit/packages" />
  </packageSources>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
