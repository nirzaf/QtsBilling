@page "/login"
@inject IPkceLoopbackAuthenticator Authenticator
@inject NavigationManager Navigation

<PageTitle>Sign in - QTS Billing</PageTitle>

<MudText Typo="Typo.h3">Sign in</MudText>
<MudText Typo="Typo.body2" Class="mt-2 mb-4">
    Sign in through your system browser. QTS Billing never asks this desktop app to collect or store your password.
</MudText>

<MudCard Class="ma-4" Style="max-width: 420px;">
    <MudCardContent>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mt-3"
                   Disabled="@_busy"
                   OnClick="SignInAsync">
            @(_busy ? "Waiting for browser sign-in..." : "Continue in browser")
        </MudButton>
    </MudCardContent>
</MudCard>

@code {
    private string? _error;
    private bool _busy;

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            await Authenticator.AuthenticateAsync();
            Navigation.NavigateTo("customers");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
